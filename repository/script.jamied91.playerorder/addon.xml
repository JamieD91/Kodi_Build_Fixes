<?xml version='1.0' encoding='utf-8'?>
<addon id="script.jamied91.playerorder" name="Jamie Player Menu Organiser" version="0.1.0" provider-name="JamieD91">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="plugin.video.themoviedb.helper" version="6.20.3" />
  </requires>
  <extension point="xbmc.python.script" library="addon.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Jamie Player Menu Organiser</summary>
    <description lang="en_GB">Saved ordering and Move up / Move down for TMDb Helper player menus. Open this program add-on to enable the checked chooser integration, then restart Kodi.</description>
    <platform>all</platform>
    <license>GPL-3.0-or-later</license>
    <source>https://github.com/JamieD91/Kodi_Build_Fixes</source>
    <website>https://jamied91.github.io/Kodi_Build_Fixes/</website>
    <news>First release: skin-aware player ordering, context menu, preview and reversible integration.</news>
  </extension>
</addon>
